# ---- Backend (backend/.env) ----
NODE_ENV=development
PORT=4000

# Postgres connection (development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_dealership_dev
DB_USER=dealership
DB_PASSWORD=dealership

# Postgres connection used when NODE_ENV=test
TEST_DB_NAME=car_dealership_test

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# CORS origin for the Vite dev server
CLIENT_ORIGIN=http://localhost:5173

# ---- Frontend (frontend/.env) ----
VITE_API_URL=http://localhost:4000
